name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        neovim: [{% for version in selected_versions %}"{{ version.id }}"{% if not loop.last %}, {% endif %}{% endfor %}]
        include:
{% for version in selected_versions %}          - neovim: "{{ version.id }}"
            version: "{{ version.ci }}"
{% endfor %}
    steps:
      - uses: actions/checkout@v7
      - name: Install Lua build dependencies
        run: sudo apt-get update && sudo apt-get install --yes --no-install-recommends libreadline-dev
      - uses: jdx/mise-action@v4
      - uses: rhysd/action-setup-vim@v1
        id: neovim
        with:
          neovim: true
{% raw %}
          version: ${{ matrix.version }}
      - uses: actions/cache@v5
        with:
          path: .lux
          key: lux-${{ runner.os }}-${{ matrix.neovim }}-${{ hashFiles('lux.toml', 'lux.lock') }}
      # nlua executes nvim from PATH; select the matrix executable explicitly.
      - run: |
          nvim_dir="$(dirname "$NVIM")"
          export PATH="$nvim_dir:$PATH"
          "$NVIM" --version
          lx --no-luarc test
          git diff --exit-code -- lux.lock
        env:
          NVIM: ${{ steps.neovim.outputs.executable }}
      - run: mise run check
        env:
          NVIM_BIN: ${{ steps.neovim.outputs.executable }}
{% endraw %}

  lint:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      - name: Install Lua build dependencies
        run: sudo apt-get update && sudo apt-get install --yes --no-install-recommends libreadline-dev
      - uses: jdx/mise-action@v4
      - run: gh extension install noirbizarre/gh-ship --pin 0.6.0
        env:
{% raw %}
          GH_TOKEN: ${{ github.token }}
{% endraw %}
      - run: mise run format
      - run: git diff --exit-code -- lua/ plugin/ scripts/ spec/
      - run: mise run lint
      - name: Show documentation repair instructions
        if: failure()
        run: |
          git diff -- doc/
          echo 'For stale help: run mise run docs, stage doc/, and rerun the hook before pushing.'
      - run: prek run --all-files
