default_install_hook_types = ["pre-commit", "commit-msg"]

[[repos]]
repo = "builtin"
hooks = [
  { id = "check-added-large-files" },
  { id = "check-merge-conflict" },
  { id = "check-toml" },
  { id = "check-yaml" },
  # Lux serializes its lockfile without a trailing newline.
  { id = "end-of-file-fixer", exclude = "^lux\\.lock$" },
  { id = "trailing-whitespace" },
]

[[repos]]
repo = "local"
hooks = [
  { id = "lux-fmt", name = "Lux format", language = "system", entry = "mise run format", types = ["lua"], pass_filenames = false },
  { id = "lux-lint", name = "Lux lint", language = "system", entry = "mise run lint:lua", types = ["lua"], pass_filenames = false },
  { id = "lux-check", name = "Lux check", language = "system", entry = "mise run check", types = ["lua"], pass_filenames = false },
]

[[repos]]
repo = "https://github.com/kdheepak/panvimdoc"
rev = "v6.0.0"

[[repos.hooks]]
id = "panvimdoc"
files = "^(README\\.md$|doc/|prek\\.toml$|mise\\.toml$)"
args = [
  "--input-file", "README.md",
  "--project-name", "{{ module_name }}",
  "--description", "Neovim plugin",
  "--no-date", "true",
  "--no-vim-version", "true",
  "--toc", "true",
  "--dedup-subheadings", "true",
  "--treesitter", "true",
  "--ignore-rawblocks", "true",
]

[[repos]]
repo = "https://github.com/rhysd/actionlint"
rev = "v1.7.12"
hooks = [{ id = "actionlint-system" }]

[[repos]]
repo = "https://github.com/DavidAnson/markdownlint-cli2"
rev = "v0.23.2"
hooks = [{ id = "markdownlint-cli2" }]

[[repos]]
repo = "https://github.com/crate-ci/typos"
rev = "v1.47.1"
hooks = [{ id = "typos" }]

[[repos]]
repo = "https://github.com/alessandrojcm/commitlint-pre-commit-hook"
rev = "v9.21.0"
hooks = [{ id = "commitlint", stages = ["commit-msg"], additional_dependencies = ["@commitlint/config-conventional"] }]

# Add project-specific hooks below this line.
