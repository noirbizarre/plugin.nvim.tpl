if vim.g.loaded_{{ module_name }} then
    return
end
vim.g.loaded_{{ module_name }} = true

-- Keep implementation modules unloaded until the command is used.
vim.api.nvim_create_user_command("{{ command_name }}", function(opts)
    require("{{ module_name }}").greet(opts.args ~= "" and opts.args or nil)
end, { nargs = "?", desc = "Show an example greeting" })
